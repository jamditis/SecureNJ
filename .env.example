# Copy this file to .env.local and change the values. All values are optional.
# These values go into the public build. Do not put secrets here.

# The signaling servers that the space dialog shows as the default.
# Separate more than one address with a comma.
# VITE_SIGNALING_URLS=wss://signaling.example.org

# STUN servers that help peers on different networks connect.
# The default is stun:stun.l.google.com:19302. A STUN server sees the IP
# address of each peer. Set an empty value to use no STUN server; sync then
# works only between devices on the same local network.
# VITE_ICE_SERVERS=stun:stun.example.org:3478

# The public address of your copy. Link previews need it.
# VITE_SITE_URL=https://toolkit.example.org

# The address that the dev server listens on. The default is this computer
# only. Use 0.0.0.0 to open the dev server to the local network.
# VITE_DEV_HOST=0.0.0.0
